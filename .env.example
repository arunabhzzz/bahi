# Copy to .env if needed. Everything here is optional for local use.
PORT=4317
BAHI_DB=data/bahi.sqlite

# --- Hosting for Alexa+ (leave unset for local-only) ---
# BAHI_HOST=0.0.0.0
# BAHI_PUBLIC_URL=https://your-host.example.com
# BAHI_ALLOWED_HOSTS=other-name.example.com
# BAHI_TRUST_PROXY=true
# Bearer token the MCP client sends; 32+ random characters (openssl rand -hex 32)
# BAHI_CONNECTOR_TOKEN=
# BAHI_CONNECTOR_SEED=true

# --- Optional language-model mode for the simulator ---
BAHI_MODEL_ENABLED=false
# BAHI_MODEL_URL=https://api.example.com/v1/chat/completions
# BAHI_MODEL_NAME=
# BAHI_MODEL_KEY=
# BAHI_MODEL_MAX_CALLS_PER_SESSION=60
# BAHI_MODEL_MAX_CALLS=1000
